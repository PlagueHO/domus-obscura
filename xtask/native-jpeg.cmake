cmake_minimum_required(VERSION 3.24)

# Pin the official release tarball, not GitHub's unsupported generated archive.
set(VERSION "3.2.0")
set(SHA256 "6f30092cef9fb839779646608f4ee14ae3cbac989c47fa05e841b0841f09878e")
set(URL "https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/${VERSION}/libjpeg-turbo-${VERSION}.tar.gz")
if(NOT DEFINED OUT_ROOT)
    message(FATAL_ERROR "OUT_ROOT is required")
endif()
if(NOT DEFINED HOST_KEY OR NOT HOST_KEY MATCHES "^[A-Za-z0-9_-]+$")
    message(FATAL_ERROR "A native Rust HOST_KEY is required")
endif()
get_filename_component(OUT_ROOT "${OUT_ROOT}" ABSOLUTE)
set(ROOT "${OUT_ROOT}/native")
string(SUBSTRING "${SHA256}" 0 8 KEY)
file(MAKE_DIRECTORY "${ROOT}")
file(LOCK "${ROOT}/build.lock" GUARD PROCESS TIMEOUT 120)
set(BUILD "${OUT_ROOT}/n")
if(STATIC_CRT)
    set(CRT "static")
    set(CRT_DLL OFF)
    set(PATH_FILE "library-path-static")
else()
    set(CRT "dll")
    set(CRT_DLL ON)
    set(PATH_FILE "library-path")
endif()
set(LIB_DIR "${ROOT}/${HOST_KEY}/l${KEY}-r2-${CRT}")
if(WIN32)
    set(LIBRARY "${LIB_DIR}/turbojpeg.lib")
else()
    set(LIBRARY "${LIB_DIR}/libturbojpeg.a")
endif()
if(EXISTS "${LIBRARY}")
    file(WRITE "${ROOT}/${HOST_KEY}/${PATH_FILE}" "${LIB_DIR}\n")
    return()
endif()
set(ARCHIVE "${ROOT}/libjpeg-turbo-${VERSION}.tar.gz")
if(NOT EXISTS "${ARCHIVE}")
    message(STATUS "Downloading pinned libjpeg-turbo ${VERSION}")
    file(DOWNLOAD "${URL}" "${ARCHIVE}.part"
        TLS_VERIFY ON EXPECTED_HASH "SHA256=${SHA256}"
        TIMEOUT 120 INACTIVITY_TIMEOUT 30 STATUS DOWNLOAD_STATUS)
    list(GET DOWNLOAD_STATUS 0 DOWNLOAD_CODE)
    if(NOT DOWNLOAD_CODE EQUAL 0)
        message(FATAL_ERROR "Native source download failed: ${DOWNLOAD_STATUS}")
    endif()
    file(RENAME "${ARCHIVE}.part" "${ARCHIVE}")
endif()
file(SHA256 "${ARCHIVE}" ACTUAL_SHA256)
if(NOT ACTUAL_SHA256 STREQUAL SHA256)
    message(FATAL_ERROR "Native JPEG source checksum failed")
endif()
set(SOURCE "${ROOT}/src/libjpeg-turbo-${VERSION}")
if(NOT EXISTS "${SOURCE}/CMakeLists.txt")
    file(MAKE_DIRECTORY "${ROOT}/src")
    file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${ROOT}/src")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --fresh -S "${SOURCE}" -B "${BUILD}"
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON
    -DCMAKE_INSTALL_PREFIX=${BUILD}/install
    -DENABLE_SHARED=OFF -DENABLE_STATIC=ON -DWITH_SIMD=OFF
    -DWITH_TOOLS=OFF -DWITH_TESTS=OFF -DWITH_CRT_DLL=${CRT_DLL}
    RESULT_VARIABLE CONFIGURE_CODE)
if(NOT CONFIGURE_CODE EQUAL 0)
    message(FATAL_ERROR "Native JPEG configuration failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BUILD}" --config Release
    --target turbojpeg-static --parallel 2 RESULT_VARIABLE BUILD_CODE)
if(NOT BUILD_CODE EQUAL 0)
    message(FATAL_ERROR "Native JPEG compilation failed")
endif()
file(MAKE_DIRECTORY "${LIB_DIR}")
if(WIN32)
    set(COMPILED "${BUILD}/Release/turbojpeg-static.lib")
    if(NOT EXISTS "${COMPILED}")
        set(COMPILED "${BUILD}/turbojpeg-static.lib")
    endif()
else()
    set(COMPILED "${BUILD}/libturbojpeg.a")
endif()
file(MAKE_DIRECTORY "${LIB_DIR}/licenses")
foreach(NOTICE LICENSE.md README.ijg)
    file(COPY "${SOURCE}/${NOTICE}" DESTINATION "${LIB_DIR}/licenses")
endforeach()
file(COPY_FILE "${COMPILED}" "${LIBRARY}" ONLY_IF_DIFFERENT)
file(WRITE "${ROOT}/${HOST_KEY}/${PATH_FILE}" "${LIB_DIR}\n")

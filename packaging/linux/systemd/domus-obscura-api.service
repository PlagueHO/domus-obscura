[Unit]
Description=Domus Obscura API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=domus-obscura
Group=domus-obscura
WorkingDirectory=/opt/domus-obscura
ExecStart=/opt/domus-obscura/domus systemd-service api /var/lib/domus-obscura/config/service.json
Restart=on-failure
RestartSec=30
TimeoutStartSec=120
TimeoutStopSec=180
KillSignal=SIGTERM
KillMode=mixed
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/domus-obscura
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

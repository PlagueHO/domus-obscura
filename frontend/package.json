{
  "name": "@domus/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "build": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build --config vite.app.config.ts",
    "build:local-test": "tsc --noEmit && vite build --config vite.local-test.config.ts",
    "test:browser": "playwright test",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@headless-tree/core": "1.8.1",
    "@headless-tree/react": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
